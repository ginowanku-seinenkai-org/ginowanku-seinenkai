---
// S04 お知らせ・行事の詳細。活動記録の ID では作らない（03 §6.1）
import type { GetStaticPaths } from 'astro';
import PostDetail from '../../components/PostDetail.astro';
import { loadSiteData } from '../../lib/data.ts';
import type { PublicPost } from '../../lib/view-schemas.ts';

export const getStaticPaths = (async () => {
  const data = await loadSiteData();
  return data.posts
    .filter((p) => p.kind !== 'activity')
    .map((post) => ({ params: { id: String(post.id) }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: PublicPost };
---

<PostDetail post={post} />
