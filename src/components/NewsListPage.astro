---
// お知らせ・行事の一覧（S03。03 §6.3・§6.5）。すべて／種類別、1ページ目／2ページ目以降で共通
import BaseLayout from '../layouts/BaseLayout.astro';
import KindTabs from './KindTabs.astro';
import PageHead from './PageHead.astro';
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';
import { loadSiteData } from '../lib/data.ts';
import { DESCRIPTIONS, EMPTY } from '../lib/messages.ts';
import { KIND_LABELS, newsPosts, pageUrl, paginate } from '../lib/posts.ts';
import { buildMeta } from '../lib/seo.ts';
import type { NewsKind } from '../lib/view-schemas.ts';

/** kind：種類（すべてなら null）。page：表示するページ番号（1から） */
interface Props {
  kind: NewsKind | null;
  page: number;
}
const { kind, page } = Astro.props;
const data = await loadSiteData();
const pages = paginate(newsPosts(data, kind ?? undefined));
const current = pages[page - 1] ?? { items: [], currentPage: page, lastPage: pages.length };
const base = kind === null ? '/news' : `/news/category/${kind}`;
const listName = kind === null ? 'お知らせ・行事' : `${KIND_LABELS[kind]}｜お知らせ・行事`;
const meta = buildMeta({
  name: listName,
  page,
  path: pageUrl(base, page),
  description: kind === null ? DESCRIPTIONS.news : DESCRIPTIONS.newsCategory[kind],
});
const title = kind === null ? 'お知らせ・行事' : `お知らせ・行事：${KIND_LABELS[kind]}`;
const crumbs =
  kind === null
    ? [{ label: 'お知らせ・行事' }]
    : [{ label: 'お知らせ・行事', href: '/news' }, { label: KIND_LABELS[kind] }];
---

<BaseLayout meta={meta} current="news">
  <PageHead title={title} crumbs={crumbs} />
  <div class="wrap sec">
    <KindTabs current={kind} />
    {current.items.length === 0 ? (
      <p class="empty">{kind === null ? EMPTY.news : EMPTY.newsCategory}</p>
    ) : (
      <ul class="cards">
        {current.items.map((post) => (
          <li>
            <PostCard post={post} data={data} />
          </li>
        ))}
      </ul>
    )}
    <Pagination base={base} currentPage={current.currentPage} lastPage={current.lastPage} />
  </div>
</BaseLayout>
