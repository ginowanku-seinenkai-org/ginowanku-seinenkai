---
import type { GetStaticPaths } from 'astro';
import ActivityListPage from '../../../components/ActivityListPage.astro';
import { loadSiteData } from '../../../lib/data.ts';
import { activityPosts, paginate } from '../../../lib/posts.ts';

export const getStaticPaths = (async () => {
  const data = await loadSiteData();
  return paginate(activityPosts(data))
    .slice(1)
    .map((p) => ({ params: { page: String(p.currentPage) } }));
}) satisfies GetStaticPaths;

const page = Number(Astro.params.page);
---

<ActivityListPage page={page} />
