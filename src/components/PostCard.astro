---
// 記事カード（03 §6.2）。演舞は data-event-end でブラウザでも「終了」を再判定する（03 §7）
// 中止の演舞は「終了」の代わりに「中止」の印を出し、再判定しない（13 §6.2）
import { formatPublishedOn } from '../lib/date.ts';
import {
  KIND_LABELS,
  eventEndDate,
  isCancelled,
  isEnded,
  photoSrc,
  postUrl,
} from '../lib/posts.ts';
import type { SiteData } from '../lib/data.ts';
import type { PublicPost } from '../lib/view-schemas.ts';
import EndedBadge from './EndedBadge.astro';
import EventDate from './EventDate.astro';
import KindLabel from './KindLabel.astro';

/** post：記事。data：サイトのデータ（写真と今日の日付を使う） */
interface Props {
  post: PublicPost;
  data: SiteData;
}
const { post, data } = Astro.props;
const cover = post.cover_photo_id === null ? undefined : data.photos.get(post.cover_photo_id);
const cancelled = isCancelled(post);
const ended = !cancelled && isEnded(post, data.today);
const endDate = cancelled ? null : eventEndDate(post);
---

<article
  class:list={['card', { 'is-ended': ended, 'is-cancelled': cancelled }]}
  data-event-end={endDate ?? undefined}
  data-ended-behavior={endDate ? 'badge' : undefined}
>
  {cover ? (
    <img
      class="thumb"
      src={photoSrc(cover, 'thumb')}
      width={cover.thumb_width}
      height={cover.thumb_height}
      alt={cover.alt}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class={`kindbox k-${post.kind}`} aria-hidden="true">
      {KIND_LABELS[post.kind]}
    </div>
  )}
  <div class="tags">
    <KindLabel kind={post.kind} />
    {endDate && <EndedBadge ended={ended} />}
    {cancelled && <span class="badge-cancelled">中止</span>}
  </div>
  <a class="ttl" href={postUrl(post)}>
    {post.title}
  </a>
  <span class="when">
    {post.kind === 'event' && post.event_starts_at !== null ? (
      <EventDate post={post} />
    ) : (
      <time datetime={post.published_on}>{formatPublishedOn(post.published_on)}</time>
    )}
  </span>
</article>
