{
  "name": "ginowanku-seinenkai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "fetch-photos": "tsx scripts/fetch-photos.ts",
    "build": "astro build && tsx scripts/postbuild.ts",
    "build:fixture": "tsx scripts/prepare-fixture.ts && astro build && tsx scripts/postbuild.ts",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run --exclude 'tests/dist/**'",
    "test:dist": "vitest run tests/dist",
    "test:e2e": "playwright test",
    "test:lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@supabase/supabase-js": "2.117.3",
    "astro": "7.3.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "simple-icons": "16.32.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
