---
// S10 プライバシーポリシー（文面は 06 §7。03 §6.5）
// 文面を変えるコミットで、同時に src/lib/privacy.ts の PRIVACY_VERSION を改定日に変える（03 §8.3）
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { DESCRIPTIONS } from '../lib/messages.ts';
import { PRIVACY_ESTABLISHED_ON, PRIVACY_VERSION } from '../lib/privacy.ts';
import { buildMeta } from '../lib/seo.ts';

const meta = buildMeta({
  name: 'プライバシーポリシー',
  path: '/privacy',
  description: DESCRIPTIONS.privacy,
});
const sections = [
  ['operator', '運営者'],
  ['information', 'お預かりする情報'],
  ['purpose', '利用目的'],
  ['retention', '保存期間'],
  ['requests', '削除・開示などのご依頼'],
  ['services', '外部サービスの利用'],
  ['overseas', '海外の事業者のサービスで取り扱うことについて'],
  ['analytics', 'アクセス計測について'],
  ['minors', '未成年の方について'],
  ['third-party', '第三者への提供'],
  ['security', '安全管理のための措置'],
  ['revision', 'このポリシーの改定'],
  ['contact', 'お問い合わせ・ご相談の窓口'],
  ['law', '準拠法と管轄'],
] as const;
const mail = 'info@ginowanku-seinenkai.com';
---

<BaseLayout meta={meta}>
  <PageHead title="プライバシーポリシー" crumbs={[{ label: 'プライバシーポリシー' }]} />
  <div class="wrap narrow article policy">
    <p>
      宜野湾区青年会（以下「当会」）は、ホームページ（ginowanku-seinenkai.com）でお預かりする個人情報を、個人情報の保護に関する法律などの法令を守り、次のとおり取り扱います。
    </p>

    <nav class="toc" aria-labelledby="toc-heading">
      <h2 id="toc-heading">目次</h2>
      <ol>
        {sections.map(([id, label]) => (
          <li>
            <a href={`#${id}`}>{label}</a>
          </li>
        ))}
      </ol>
    </nav>

    <section>
      <h2 id="operator">1. 運営者</h2>
      <ul>
        <li>名称：宜野湾区青年会</li>
        <li>所在地：沖縄県宜野湾市宜野湾1丁目22-24（宜野湾区自治会事務所内）</li>
        <li>連絡先：{mail}</li>
      </ul>
    </section>

    <section>
      <h2 id="information">2. お預かりする情報</h2>
      <h3>お問い合わせフォームに入力いただく情報</h3>
      <ul>
        <li>
          演舞依頼：団体名、担当者のお名前、メールアドレス、電話番号（任意）、希望日時、場所、イベント内容、希望演舞時間、備考
        </li>
        <li>
          入会希望：お名前、年齢、性別（任意）、メールアドレス、電話番号（任意）、自由記入の内容
        </li>
        <li>その他：お名前、団体名（任意）、メールアドレス、電話番号（任意）、お問い合わせ内容</li>
      </ul>
      <h3>管理画面を使う会員の情報</h3>
      <ul>
        <li>
          会員が管理画面にLINEでログインするときの、LINEのユーザーID（LINEが利用者ごとに割り当てる番号）と表示名
        </li>
      </ul>
      <h3>フォームの送信やページの表示にともなって自動的に送られる情報</h3>
      <ul>
        <li>
          スパム対策のため、お問い合わせフォームを表示・送信するときに、IPアドレスやブラウザの種類などの情報が、Cloudflare社のスパム対策サービス（Turnstile）に送られます。
        </li>
        <li>
          記事に埋め込んだ動画や投稿（YouTube・TikTok・Instagram）を表示すると、IPアドレスやブラウザの種類などの情報が、各社（Google社・TikTok社・Meta社）に送られます。送られた情報は各社のプライバシーポリシーに従って扱われます。
        </li>
        <li>
          当会のメールアドレス（{mail}
          ）にメールを送られた場合、差出人・宛先・件名・本文と、添付ファイルの名前・種類・大きさ（中身は除く）を、当会が利用する
          Supabase（6.）に保存します。
        </li>
        <li>
          ページを英語の表示に切り替えると、ページの文章と、IPアドレスやブラウザの種類などの情報が、Google社の翻訳サービスに送られます。英語の表示を選んだことを覚えるため、Google社の
          Cookie（googtrans）を使います。日本語の表示のままなら、これらは送られません。送られた情報は
          Google社のプライバシーポリシーに従って扱われます。
        </li>
        <li>
          いたずらや大量送信を防ぐため、フォームの送信回数と、自動返信メールの送信回数を数えます。このとき、IPアドレスとメールアドレスはそのまま保存せず、元に戻せない形に変換した値を2日間だけ保存します。
        </li>
        <li>
          ホームページの利用状況を知るため、表示されたページ、どのサイトから来たか（サイトのドメイン名のみ）、端末とブラウザの種類（iPhone・Android・Windows、Safari・Chrome
          など。ブラウザの情報そのものは保存しません）を記録します。詳しくは「8.
          アクセス計測について」をご覧ください。
        </li>
      </ul>
      <p>
        当会の役員の役職・氏名・写真は、本人の同意を得て、ホームページの「役員紹介」に掲載します。
      </p>
    </section>

    <section>
      <h2 id="purpose">3. 利用目的</h2>
      <p>お預かりした情報は、次の目的にだけ使います。</p>
      <ul>
        <li>お問い合わせへの返信と、そのための連絡</li>
        <li>演舞依頼の検討、日程や内容の調整、当日までの連絡</li>
        <li>入会希望の方への活動の案内と、入会のご相談への対応</li>
        <li>いたずら・大量送信などの防止</li>
        <li>ホームページの利用状況を把握し、改善すること（個人を特定しない形で集計します）</li>
        <li>
          会員の本人確認と、管理画面の権限の管理（当会のLINEグループに参加しているかの確認を含みます）
        </li>
      </ul>
      <p>これ以外の目的に使う場合は、あらかじめご本人の同意をいただきます。</p>
    </section>

    <section>
      <h2 id="retention">4. 保存期間</h2>
      <ul>
        <li>
          お問い合わせの内容は、期間を定めずに保存します（過去の依頼の経緯を確認するためです）。ご本人から削除の依頼があった場合は、当会のデータベースから削除します（「5.
          削除・開示などのご依頼」）。
        </li>
        <li>
          当会は、データの消失に備えて月に1回バックアップ（暗号化した複製）を作り、12か月分を保管しています。削除のご依頼をいただいた情報も、それ以前に作ったバックアップには最長で12か月残り、その後に消えます。バックアップは、障害などで元のデータが失われたときの復元にだけ使います。
        </li>
        <li>当会のメールアドレスに届いたメールと、当会が送ったメールの記録は、2年で削除します。</li>
        <li>送信回数を数えるための記録は2日で削除します。</li>
        <li>アクセス計測の記録は90日で削除し、その後は日ごとの合計の数だけを残します。</li>
      </ul>
    </section>

    <section>
      <h2 id="requests">5. 削除・開示などのご依頼</h2>
      <p>
        ご自身の情報について、削除、内容の確認（開示）、訂正、利用の停止を希望される場合は、{mail}{' '}
        までメールでご連絡ください。
      </p>
      <ul>
        <li>
          ご本人であることを確認するため、原則として、お問い合わせのときに入力したメールアドレスからご連絡ください。それ以外の方法でご連絡いただいた場合は、確認のためにお尋ねすることがあります。
        </li>
        <li>
          削除のご依頼をいただいたときは、当会のデータベースから削除します。当会の共用メール（Gmail）に届いたお問い合わせのメールは、対応の記録として残します（法令により消去が必要な場合を除きます）。
        </li>
        <li>手数料はいただきません。</li>
        <li>1週間以内を目安に返信し、対応した結果をお知らせします。</li>
      </ul>
    </section>

    <section>
      <h2 id="services">6. 外部サービスの利用</h2>
      <p>
        当会は、ホームページの運営に次の外部サービスを利用しています。お預かりした情報は、これらのサービスに保存されたり、これらのサービスを通じて送られたりします。海外の事業者のサービスを含みます。
      </p>
      {/* 横にスクロールする表はキーボードでも操作できるようにする（axe：scrollable-region-focusable） */}
      <div class="tbl-wrap" tabindex="0" role="region" aria-labelledby="services">
        <table class="tbl">
          <thead>
            <tr>
              <th scope="col">サービス</th>
              <th scope="col">事業者（所在国）</th>
              <th scope="col">情報を保存・処理する場所</th>
              <th scope="col">取り扱う情報</th>
              <th scope="col">使う目的</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Supabase</th>
              <td>Supabase Pte. Ltd.（シンガポール）</td>
              <td>日本（東京）</td>
              <td>
                お問い合わせの内容、当会のメールアドレスに届いたメールと当会が送ったメール、アクセス計測の記録、送信回数の記録、管理画面を使う会員のLINEのユーザーIDと表示名
              </td>
              <td>データの保存、フォームの受付処理、管理画面のログイン</td>
            </tr>
            <tr>
              <th scope="row">Resend</th>
              <td>Plus Five Five, Inc.（アメリカ）</td>
              <td>アメリカ</td>
              <td>お問い合わせの内容、メールアドレス、当会からの返信の内容</td>
              <td>当会あての通知メール、自動返信メール、管理画面からの返信の送信</td>
            </tr>
            <tr>
              <th scope="row">Gmail</th>
              <td>Google LLC（アメリカ）</td>
              <td>特定できません（事業者が保存場所を公表しておらず、利用者が選べないため）</td>
              <td>お問い合わせの内容</td>
              <td>当会の共用メールでの受信と、ご本人への返信</td>
            </tr>
            <tr>
              <th scope="row">Cloudflare（Turnstile、ホームページの配信、メール転送）</th>
              <td>Cloudflare, Inc.（アメリカ）</td>
              <td>特定できません（世界各地の拠点のうち、利用者に近い拠点で処理されるため）</td>
              <td>IPアドレス、ブラウザの情報、{mail} あてのメール</td>
              <td>スパム対策、ホームページの配信、メールの転送</td>
            </tr>
            <tr>
              <th scope="row">GitHub</th>
              <td>GitHub, Inc.（アメリカ）</td>
              <td>アメリカ</td>
              <td>暗号化したバックアップ（内容は当会以外は読めません）</td>
              <td>バックアップの保管</td>
            </tr>
            <tr>
              <th scope="row">LINE</th>
              <td>LINEヤフー株式会社（日本）</td>
              <td>—</td>
              <td>
                役員だけのLINEグループには、お問い合わせの内容（お名前・連絡先を含む）を送ります。会員全員のLINEグループには、お問い合わせの種類・受付日時・受付番号のみを送ります（お名前や連絡先は送りません）。会員のログインでは、当会がLINEからユーザーIDと表示名を受け取ります
              </td>
              <td>会員のLINEグループへの受付のお知らせ、会員の管理画面へのログイン</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        Turnstileに送られる情報は、Cloudflare社が自社のボット（自動プログラム）検出の改善にも利用します。詳しくはCloudflare社の「Turnstile
        Privacy Addendum」をご覧ください。
      </p>
    </section>

    <section>
      <h2 id="overseas">7. 海外の事業者のサービスで取り扱うことについて</h2>
      <p>
        6.のとおり、お預かりした情報は、アメリカとシンガポールの事業者のサービスで取り扱い、保存・処理する場所が日本の外になる場合があります。お問い合わせフォームの送信にあたっては、このことへの同意をお願いしています。
      </p>
      <ul>
        <li>
          各国の個人情報の保護に関する制度は、個人情報保護委員会のウェブサイト「諸外国・地域の法制度」で公開されています（アメリカ：
          <a
            href="https://www.ppc.go.jp/enforcement/infoprovision/laws/offshore_report_america/"
            target="_blank"
            rel="noopener noreferrer"
          >
            https://www.ppc.go.jp/enforcement/infoprovision/laws/offshore_report_america/
          </a>
          、シンガポール：
          <a
            href="https://www.ppc.go.jp/enforcement/infoprovision/laws/offshore_report_singapore/"
            target="_blank"
            rel="noopener noreferrer"
          >
            https://www.ppc.go.jp/enforcement/infoprovision/laws/offshore_report_singapore/
          </a>
          ）。
        </li>
        <li>
          当会は、これらの制度を確認したうえで、各事業者が公表している個人情報の取扱いの方針や契約条件を確認し、取り扱う情報を必要なものに絞る、通信を暗号化する、利用する人を限る、バックアップを暗号化する、といった措置をとっています。
        </li>
      </ul>
    </section>

    <section>
      <h2 id="analytics">8. アクセス計測について</h2>
      <p>
        当会は、ホームページの利用状況を知るため、独自の方法でアクセスを数えています。他社のアクセス解析サービスは使いません。
      </p>
      <ul>
        <li>Cookie（クッキー）は使いません。</li>
        <li>IPアドレスは保存しません。</li>
        <li>
          訪問者の数は、その日だけ使う秘密の値とIPアドレス・ブラウザの情報を組み合わせて作った、日ごとに変わる匿名の番号で数えます。秘密の値は毎日作り直し、前日の分は捨てるため、この番号から個人やIPアドレスを割り出すことはできません。また、日をまたいで同じ人を追いかけることもできません。
        </li>
        <li>
          記録する内容は、表示されたページ、来訪元のサイトのドメイン名、端末とブラウザの種類、日時です。記録は当会が利用する
          Supabase（6.）に送られます。
        </li>
        <li>
          ブラウザの設定で「グローバル・プライバシー・コントロール（GPC）」または「トラッキング拒否（Do
          Not Track）」を有効にしている場合は、アクセスを記録しません。
        </li>
      </ul>
    </section>

    <section>
      <h2 id="minors">9. 未成年の方について</h2>
      <ul>
        <li>メンバー募集（入会希望）の対象は高校生以上です。</li>
        <li>
          18歳未満の方がお問い合わせフォームを使う場合は、保護者の方にもご確認のうえ送信してください。
        </li>
      </ul>
    </section>

    <section>
      <h2 id="third-party">10. 第三者への提供</h2>
      <p>当会は、次の場合を除き、お預かりした個人情報をご本人の同意なく第三者に渡しません。</p>
      <ul>
        <li>法令にもとづく場合</li>
        <li>人の生命・身体・財産を守るために必要で、ご本人の同意を得ることが難しい場合</li>
        <li>その他、個人情報保護法で認められている場合</li>
      </ul>
      <p>6.の外部サービスの利用は、当会の運営のためにサービスを利用するものです。</p>
    </section>

    <section>
      <h2 id="security">11. 安全管理のための措置</h2>
      <p>当会は、お預かりした情報を守るため、次のことを行っています。</p>
      <ul>
        <li>
          お問い合わせの氏名・連絡先を見られるのは、当会の管理者に限っています。当会の共用メール（Gmail）を見られる人と、お問い合わせの内容が届く役員だけのLINEグループに参加している人も、管理者に限っています。その他の会員には、氏名・メールアドレス・電話番号・年齢・性別を伏せた内容（団体名と依頼の内容）だけが表示されます。管理者がお問い合わせの詳細を表示したことと、内容を変更したことを記録しています。
        </li>
        <li>
          管理画面には、当会のLINEグループに参加している会員だけが、LINEのアカウントでログインできます。グループを抜けた会員のアカウントは自動で停止し、停止したアカウントはその時点から操作できなくなります。
        </li>
        <li>通信はすべて暗号化（HTTPS）しています。</li>
        <li>
          会員のLINEグループへのお知らせや自動返信メールには、お問い合わせの内容やお名前を含めません。
        </li>
        <li>誰がいつお問い合わせを削除したかなど、重要な操作を記録しています。</li>
        <li>バックアップは暗号化して保管しています。</li>
        <li>
          海外の事業者のサービスを利用するにあたり、7.のとおり、その国の制度を確認しています。
        </li>
      </ul>
    </section>

    <section>
      <h2 id="revision">12. このポリシーの改定</h2>
      <p>
        当会は、法令の変更や運営の見直しにあわせて、このポリシーを改定することがあります。改定したときは、このページでお知らせし、下の改定日を更新します。
      </p>
    </section>

    <section>
      <h2 id="contact">13. お問い合わせ・ご相談の窓口</h2>
      <p>個人情報の取扱いについてのお問い合わせ、ご相談、苦情は、次の窓口までご連絡ください。</p>
      <p>
        宜野湾区青年会{'\u3000'}
        {mail}
      </p>
    </section>

    <section>
      <h2 id="law">14. 準拠法と管轄</h2>
      <p>
        このポリシーは日本の法令に従って解釈します。このポリシーに関して紛争が生じたときは、那覇地方裁判所沖縄支部を第一審の管轄裁判所とします。
      </p>
    </section>

    <p class="dates">
      制定日：<time datetime={PRIVACY_ESTABLISHED_ON}>{PRIVACY_ESTABLISHED_ON}</time>
      <br />
      最終改定日：<time datetime={PRIVACY_VERSION}>{PRIVACY_VERSION}</time>
    </p>
  </div>
</BaseLayout>
