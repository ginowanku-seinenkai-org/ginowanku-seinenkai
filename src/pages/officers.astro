---
// 役員紹介（D-121、D-122、D-124、D-125、D-132）。並び順の先頭の1人を大きく出し、2人目からを「役員」の見出しの下に並べる
// 氏名と写真は本人の同意を得て載せる。ひと言は、あるときだけ出す
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { loadSiteData, officerInitial, officerPhoto, splitOfficers } from '../lib/data.ts';
import { DESCRIPTIONS, EMPTY, OFFICERS_PAGE } from '../lib/messages.ts';
import { photoSrc } from '../lib/posts.ts';
import { buildMeta } from '../lib/seo.ts';

const data = await loadSiteData();
const { officers } = data;
const termLabel = data.settings.officer_term_label;
const meta = buildMeta({
  name: OFFICERS_PAGE.title,
  path: '/officers',
  description: DESCRIPTIONS.officers,
});
// 役員と写真の組。写真の代替テキストは空にする（すぐ隣に役職と氏名があり、氏名を代替テキストに書かないため）
const cards = officers.map((officer) => ({ officer, photo: officerPhoto(officer, data.photos) }));
const { top, rest } = splitOfficers(cards);
---

<BaseLayout meta={meta} current="officers">
  <PageHead
    title={OFFICERS_PAGE.title}
    crumbs={[{ label: OFFICERS_PAGE.title }]}
    lead={termLabel === null ? null : OFFICERS_PAGE.lead(termLabel)}
  />
  <div class="wrap article">
    {top === undefined ? (
      <p class="empty">{EMPTY.officers}</p>
    ) : (
      <div class="officer-list">
        <div class="officer-top">
          {top.photo ? (
            <img
              class="officer-photo"
              src={photoSrc(top.photo, 'thumb')}
              srcset={`${photoSrc(top.photo, 'thumb')} ${top.photo.thumb_width}w, ${photoSrc(top.photo, 'full')} ${top.photo.width}w`}
              sizes="(min-width: 768px) 480px, 100vw"
              width={top.photo.thumb_width}
              height={top.photo.thumb_height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="officer-photo officer-initial" aria-hidden="true">
              {officerInitial(top.officer.name)}
            </div>
          )}
          <div class="officer-top-body">
            <p class="officer-role">{top.officer.role}</p>
            <p class="officer-name">{top.officer.name}</p>
            {top.officer.message !== null && (
              <p class="officer-message">
                <span class="officer-quote" aria-hidden="true">
                  “
                </span>
                {top.officer.message}
              </p>
            )}
          </div>
        </div>
        {rest.length > 0 && (
          <section class="officer-others" aria-labelledby="officer-others-heading">
            <h2 class="officer-heading" id="officer-others-heading">
              {OFFICERS_PAGE.othersHeading}
            </h2>
            <ul class="officer-cards">
              {rest.map(({ officer, photo }) => (
                <li class="officer-card">
                  {photo ? (
                    <img
                      class="officer-photo"
                      src={photoSrc(photo, 'thumb')}
                      srcset={`${photoSrc(photo, 'thumb')} ${photo.thumb_width}w, ${photoSrc(photo, 'full')} ${photo.width}w`}
                      sizes="160px"
                      width={photo.thumb_width}
                      height={photo.thumb_height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="officer-photo officer-initial" aria-hidden="true">
                      {officerInitial(officer.name)}
                    </div>
                  )}
                  <p class="officer-role">{officer.role}</p>
                  <p class="officer-name">{officer.name}</p>
                  {officer.message !== null && <p class="officer-message">{officer.message}</p>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}
  </div>
</BaseLayout>
