---
// ヘッダーとナビ（03 §6.2）。menu.ts が読み込まれるまではナビを開いたまま表示する
import { loadSiteData } from '../lib/data.ts';
import { SITE_NAME } from '../lib/messages.ts';

/** ナビの項目（どれでもないページは null） */
export type NavKey =
  'top' | 'about' | 'officers' | 'songs' | 'news' | 'activities' | 'join' | 'contact' | null;
/** current：今のページのナビの項目（aria-current を付ける）。どれでもなければ null */
interface Props {
  current: NavKey;
}
const { current } = Astro.props;
// 曲目一覧は本文があるときだけ（03 S13、D-81）
const { pages } = await loadSiteData();
const items: { key: Exclude<NavKey, null>; href: string; label: string; cta?: boolean }[] = [
  { key: 'top', href: '/', label: 'トップ' },
  { key: 'about', href: '/about', label: '宜野湾区青年会について' },
  ...(pages.songs ? [{ key: 'songs' as const, href: '/songs', label: '曲目一覧' }] : []),
  // 役員紹介は曲目一覧の次（曲目一覧が無ければ「宜野湾区青年会について」の次。D-81、D-121）
  { key: 'officers', href: '/officers', label: '役員紹介' },
  { key: 'news', href: '/news', label: 'お知らせ・演舞' },
  { key: 'activities', href: '/activities', label: '活動記録' },
  { key: 'join', href: '/join', label: 'メンバー募集' },
  { key: 'contact', href: '/contact', label: '演舞依頼・お問い合わせ', cta: true },
];
---

<header class="hdr">
  <div class="wrap hdr-in" data-menu>
    <!-- サイト名は固有の名前なので翻訳しない（D-88） -->
    <a class="brand notranslate" href="/">
      <img class="brand-mark" src="/emblem.png" alt="" width="40" height="40" />
      {SITE_NAME}
    </a>
    <div class="hdr-tools">
      <!-- 日本語・英語の切り替え（D-88）。ボタンの文字は翻訳させない -->
      <button
        class="lang-btn notranslate"
        type="button"
        aria-label="English"
        data-lang-toggle
        hidden
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 5h8M7 3v2M5 5c0 4 2 7 5 8M9 5c-.5 3-2.5 6-6 8"></path>
            <path d="M13 21l4-10 4 10M14.5 17h5"></path>
          </g>
        </svg>
        <span data-lang-text>EN</span>
      </button>
      <!-- 表示の明るさ（D-86）。ライトのときは月、ダークのときは太陽 -->
      <button class="theme-btn" type="button" aria-pressed="false" data-theme-toggle hidden>
        <span class="visually-hidden">ダークモード</span>
        <svg
          class="moon"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
          ></path>
        </svg>
        <svg
          class="sun"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </g>
        </svg>
      </button>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
        <span class="bars" aria-hidden="true"></span>
        <span class="visually-hidden">メニュー</span>
      </button>
    </div>
    <nav class="nav" id="site-nav" aria-label="メインメニュー">
      <ul>
        {items.map((item) => (
          <li class={item.cta ? 'cta' : undefined}>
            <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/menu.ts';
  import '../scripts/theme.ts';
  import '../scripts/translate.ts';
</script>
